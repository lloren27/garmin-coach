# Railway / bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
SYNC_SECRET=
PUBLIC_BASE_URL=
DATABASE_URL=

# Local AI coach
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=garmin-coach:9b
GARMIN_COACH_AI_MAX_JOBS=3
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=900
OLLAMA_PLAN_NUM_PREDICT=1400
GARMIN_COACH_ANSWER_MAX_CHARS=3200
TELEGRAM_ACTION_INTERVAL_SECONDS=4

# Local voice coach
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
PIPER_BIN=
PIPER_VOICE_MODEL=
PIPER_SPEAKER=
FFMPEG_BIN=ffmpeg

# Local Garmin sync only
GARMINTOKENS=~/.garminconnect
GARMIN_COACH_API_URL=http://127.0.0.1:8000

# Local Zepp / Amazfit Helio wellness only
# Keep these credentials on the Mac root .env; never set them in Railway.
ZEPP_TOKEN=
ZEPP_USER_ID=
ZEPP_BASE_URL=
# Sync today plus this many previous days (2 = three dates total).
ZEPP_SYNC_LOOKBACK_DAYS=2
# Import Zepp workout history for today plus this many previous days.
ZEPP_ACTIVITY_SYNC_LOOKBACK_DAYS=3

# Local wattwise-core analytics engine
WATTWISE_API_URL=http://127.0.0.1:8010
WATTWISE_OWNER_SECRET=
WATTWISE_ENCRYPTION_ROOT_KEY=
WATTWISE_ACCESS_TOKEN=
WATTWISE_DOCKER_IMAGE=garmin-coach-wattwise:local
WATTWISE_DOCKER_CONTAINER=garmin-coach-wattwise
WATTWISE_DOCKER_VOLUME=garmin_coach_wattwise_data
WATTWISE_BRIDGE_DAYS=60
WATTWISE_BRIDGE_LIMIT=12
WATTWISE_BRIDGE_SPORTS=running,cycling
WATTWISE_BRIDGE_RUNNING_FORMAT=tcx
WATTWISE_BRIDGE_CYCLING_FORMAT=original
WATTWISE_BRIDGE_AFTER_SYNC=1
WATTWISE_AI_CONTEXT=1
WATTWISE_AI_LOOKBACK_DAYS=28
