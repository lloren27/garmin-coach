#!/usr/bin/env python3
"""Comandos diarios para Hybrid Guard en Garmin Coach."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import subprocess
import sys


ROOT = Path("/Users/lloren27/Projects/garmin-coach")
PYTHON = ROOT / "apps/sync-local/.venv/bin/python"
GUARD = ROOT / ".opencode/scripts/hybrid_guard.py"
OPENCODE_BIN = Path("/private/tmp/opencode-2.1.3-arm64/bin")
OPENCODE = OPENCODE_BIN / "opencode"
SCOPE = "apps/sync-local/tests/"


class UserError(Exception):
    pass


def run(args: list[str], *, cwd: Path = ROOT, env=None, capture=False) -> subprocess.CompletedProcess:
    return subprocess.run(args, cwd=cwd, env=env, text=True, capture_output=capture)


def guard(*args: str, env=None) -> int:
    return run([str(PYTHON), str(GUARD), "--project", str(ROOT), *args], env=env).returncode


def git_path(name: str) -> Path:
    result = run(["git", "-C", str(ROOT), "rev-parse", "--git-path", name], capture=True)
    if result.returncode:
        raise UserError(result.stderr.strip() or "No se pudo localizar el directorio git.")
    path = Path(result.stdout.strip())
    return path if path.is_absolute() else ROOT / path


def state_json(name: str):
    path = git_path(f"opencode-hybrid-guard/{name}")
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return None
    except (OSError, json.JSONDecodeError) as exc:
        raise UserError(f"No se puede leer el estado de Hybrid Guard ({name}): {exc}") from exc


def authorized_path_file() -> Path:
    return git_path("opencode-hybrid-guard/gc/authorized-path")


def help_text() -> None:
    print("Uso: gc <comando>")
    print("  gc start RUTA_ARCHIVO  Inicia una tarea supervisada y abre OpenCode")
    print("  gc status              Muestra el estado de Hybrid Guard")
    print("  gc finish              Revisa, valida y cierra la tarea supervisada")
    print("  gc help                Muestra esta ayuda")


def resolve_target(raw: str) -> tuple[Path, str]:
    candidate = Path(raw).expanduser()
    if not candidate.is_absolute():
        candidate = ROOT / candidate
    if candidate.is_symlink():
        raise UserError("No se permiten enlaces simbólicos como ruta autorizada.")
    try:
        resolved = candidate.resolve(strict=True)
    except FileNotFoundError as exc:
        raise UserError(f"No existe la ruta indicada: {raw}") from exc
    if not resolved.is_file():
        raise UserError(f"La ruta no es un archivo: {raw}")
    try:
        rel = resolved.relative_to(ROOT).as_posix()
    except ValueError as exc:
        raise UserError(f"La ruta queda fuera del proyecto: {raw}") from exc
    if not rel.startswith(SCOPE):
        raise UserError(f"Ruta fuera del alcance de local-coder: solo {SCOPE}.")
    return resolved, rel


def start(raw: str) -> int:
    target, rel = resolve_target(raw)
    status = run(["git", "-C", str(ROOT), "status", "--porcelain=v1",
                  "--untracked-files=all", "--ignored=matching", "--", rel], capture=True)
    if status.returncode:
        raise UserError(status.stderr.strip() or "No se pudo revisar el estado del archivo.")
    if status.stdout.strip():
        raise UserError(f"El archivo ya tiene cambios previos; no inicio ni los sobrescribo: {rel}")
    if not PYTHON.is_file() or not os.access(PYTHON, os.X_OK):
        raise UserError(f"No está disponible el Python del proyecto: {PYTHON}")

    active = state_json("active.json")
    session = state_json("launch-session.json")
    if active is not None:
        raise UserError("Ya existe una tarea activa de Hybrid Guard; usa gc status y gc finish.")
    if session and session.get("status") in ("starting", "running", "pending_review"):
        raise UserError(f"No inicio otra tarea: hay una supervisión {session['status']} pendiente.")

    if not OPENCODE.is_file() or not os.access(OPENCODE, os.X_OK):
        raise UserError(f"No está disponible el binario experimental requerido: {OPENCODE}")
    code = guard("begin", "--allow", rel, "--test", "hybrid_guard")
    if code:
        return code
    metadata = authorized_path_file()
    metadata.parent.mkdir(parents=True, exist_ok=True)
    metadata.write_text(rel + "\n", encoding="utf-8")
    metadata.chmod(0o600)

    # PATH sin Homebrew: hybrid_guard.py invoca el comando `opencode` por PATH.
    env = os.environ.copy()
    env["PATH"] = os.pathsep.join((str(OPENCODE_BIN), "/usr/bin", "/bin", "/usr/sbin", "/sbin"))
    return guard("launch", "--max-minutes", "20", env=env)


def status() -> int:
    active = state_json("active.json")
    session = state_json("launch-session.json")
    if active is not None:
        code = guard("check")
        if code not in (0, 2, 3):
            return code
    if session is None or session.get("status") in ("idle", "pending_review", "reviewed"):
        code = guard("launch-review")
        return code
    print(f"Supervisión: {session.get('status', 'desconocida')} (lectura de solo lectura)")
    print(f"PID OpenCode directo: {session.get('child_pid', 'no registrado')}")
    print("Para revisar una sesión terminada: gc finish")
    return 0


def ask(prompt: str) -> str:
    try:
        return input(prompt).strip()
    except EOFError as exc:
        raise UserError("Se requiere una respuesta humana interactiva.") from exc


def finish() -> int:
    metadata = authorized_path_file()
    try:
        rel = metadata.read_text(encoding="utf-8").strip()
    except FileNotFoundError as exc:
        raise UserError("No hay ruta autorizada guardada por gc; no puedo completar esta tarea.") from exc
    if not rel.startswith(SCOPE) or Path(rel).is_absolute() or ".." in Path(rel).parts:
        raise UserError("La ruta autorizada guardada no es válida; detengo el cierre.")

    code = guard("launch-review")
    if code:
        print("Paso bloqueante: espera a que OpenCode termine y vuelve a ejecutar gc finish.")
        return code
    session = state_json("launch-session.json")
    if not session or session.get("status") != "pending_review":
        print(f"Estado actual: {session.get('status') if session else 'sin registro'}. Se requiere pending_review.")
        print("Paso necesario: termina la sesión OpenCode supervisada y vuelve a ejecutar gc finish.")
        return 1
    if ask("¿Has revisado la sesión y confirmas ack-launch? Escribe SI: ").upper() != "SI":
        print("Sin confirmación no se ejecutó ack-launch.")
        return 1
    code = guard("ack-launch", "--reason", "La persona confirmó la revisión de la sesión supervisada mediante gc finish.", "--confirm", "REVIEWED")
    if code:
        return code

    code = guard("check")
    if code:
        print("Validación bloqueante: resuelve los cambios fuera de alcance o la supervisión pendiente indicados arriba; después ejecuta gc finish.")
        return code

    target = ROOT / rel
    if target.suffix == ".py":
        try:
            source = target.read_text(encoding="utf-8")
        except OSError as exc:
            raise UserError(f"No se puede leer el test funcional autorizado: {exc}") from exc
        if re.search(r"if\s+__name__\s*==\s*['\"]__main__['\"]\s*:", source):
            print(f"Test funcional individual: {rel}")
            result = run([str(PYTHON), str(target)], cwd=ROOT / "apps/sync-local",
                         env={**os.environ, "PYTHONPATH": str(ROOT / "apps/sync-local"), "PYTHONDONTWRITEBYTECODE": "1"})
            if result.returncode:
                print("Test funcional fallido; no se ejecutó finalize. Paso necesario: corrige el test/código y vuelve a ejecutar gc finish.")
                return result.returncode
        else:
            print(f"No se ejecuta individualmente: {rel} no declara un punto de entrada __main__.")

    code = guard("test")
    if code:
        print("Perfil hybrid_guard fallido; requiere al menos 53 tests. Paso necesario: corrige los fallos y vuelve a ejecutar gc finish.")
        return code
    print("Resumen: check OK; test funcional OK o no ejecutable individualmente; perfil hybrid_guard OK (mínimo 53 tests).")
    reviewer = ask("¿El Reviewer aprobó el resultado? Escribe SI solo si lo revisaste y aprobó: ").upper()
    if reviewer != "SI":
        print("Sin aprobación humana explícita del Reviewer no se ejecutó finalize.")
        return 1
    print("Resultado del Reviewer confirmado por la persona: aprobado.")
    if ask("¿Confirmas cerrar con finalize? Escribe SI: ").upper() != "SI":
        print("Cierre no confirmado; la tarea sigue abierta.")
        return 1
    code = guard("finalize")
    if code == 0:
        metadata.unlink(missing_ok=True)
    return code


def main(argv: list[str]) -> int:
    if not ROOT.is_dir():
        raise UserError(f"No existe la raíz configurada del proyecto: {ROOT}")
    if not PYTHON.exists():
        raise UserError(f"No existe el Python del proyecto: {PYTHON}")
    if not argv or argv[0] in ("help", "-h", "--help"):
        if len(argv) > 1:
            raise UserError("gc help no acepta argumentos adicionales.")
        help_text()
        return 0
    command = argv[0]
    if command == "start":
        if len(argv) != 2:
            raise UserError("Uso: gc start RUTA_ARCHIVO")
        return start(argv[1])
    if command == "status":
        if len(argv) != 1:
            raise UserError("Uso: gc status")
        return status()
    if command == "finish":
        if len(argv) != 1:
            raise UserError("Uso: gc finish")
        return finish()
    raise UserError(f"Comando desconocido: {command!r}. Usa gc help.")


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except UserError as exc:
        print(f"gc: {exc}", file=sys.stderr)
        sys.exit(2)
